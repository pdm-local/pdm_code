# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Instrumented libs
lib-cov

# Coverage
coverage
*.lcov
.nyc_output

# Grunt intermediate storage
.grunt

# Dependency directories
node_modules/
# Also match a bare `node_modules` entry: the trailing-slash form above only
# matches directories, so a stray symlink of that name would slip through.
node_modules
jspm_packages/
bower_components/
web_modules/

# Build output
build/Release
dist/
out
.next
.nuxt
public
result
result-*

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Secrets, in every form. The previous narrow list missed .env.production
# and anything else not ending in .local.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Parcel/Snowpack/Gatsby/Storybook cache
.cache
.parcel-cache
.storybook-out
storybook-static
.out

# Temporary folders
.tmp/
tmp/
temp/
.test-temp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Package manager lock files (keep pnpm-lock.yaml)
package-lock.json
yarn.lock

# Agents configuration
agents.config.json
.claude
agents

# PDM Code checkpoints (user data)
# These contain conversation snapshots and should not be committed
**/checkpoints/

# Action timeline before-images (per-session user data)
.pdm/timeline/

# Heap snapshots
.heap-snapshots

coverage

.pdm/tasks.json
.pdm/schedule-runs.json
.pdm/schedules.json
.generated-prompts/
.pdm/skills

# Generated quality report (baseline.json is checked in, others are not)
benchmarks/report.json
benchmarks/explain.json
benchmarks/.module-*
.github/issues/docs

# Auto-generated CSS
plugins/vscode/media/chat-panel.css

# Local scratch and manual test fixtures
.pdm-manual-test/

# Fixed-name temp dirs a Ctrl-C'd test run can leave behind
test-*-temp/
.pdm-tmp/

# Local agent/session state. Deliberately NOT a blanket .pdm/ ignore:
# .pdm/commands, .pdm/agents and .pdm/tools are skills a project is meant to commit.
.pdm/sessions/
.pdm/logs/
.pdm/index/

# Built VS Code extension (produced by `pnpm build:vscode`)
assets/*.vsix
